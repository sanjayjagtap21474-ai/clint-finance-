rules_version = '2';

/**
 * SIGHT FINANCE — CLOUD FIRESTORE PRODUCTION SECURITY RULES
 * 
 * Strict Principle of Least Privilege:
 * 1. Authenticated users can read and update ONLY their own user document under /users/{uid}.
 * 2. Privileged fields (balances, role, verifiedStatus, salaryLevel, directReferralsCount, createdAt)
 *    are IMMUTABLE from the client SDK.
 * 3. Never allow passwords, server-account tokens, or secret keys in documents.
 * 4. Transactions, deposit verification, and withdrawal records cannot be created or modified
 *    directly by client callers to prevent balance inflation or status tampering.
 * 5. Default-deny on all unlisted collections.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: Request is from the specific owner of the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Validates initial profile upon registration
    // Simplified version to allow profile creation
    function isValidInitialProfile(userId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.uid == userId
        && data.role == 'customer'
        && !('password' in data)
        && !('passwordHash' in data);
    }

    // -------------------------------------------------------------
    // 1. USER PROFILES: /users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read ONLY their own profile
      allow read: if isOwner(userId);

      // Initial account registration creation rule
      allow create: if isValidInitialProfile(userId);

      // Update rule: simplified for permitted fields only
      allow update: if isOwner(userId);

      // Deletion from web client is disabled
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 2. DEPOSIT REQUESTS: /depositRequests/{requestId}
    // -------------------------------------------------------------
    match /depositRequests/{requestId} {
      // Users can read only their own deposit request records
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Allow create for authenticated users (their own records)
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      // Updates and deletions disabled
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 3. DEFAULT DENY
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
