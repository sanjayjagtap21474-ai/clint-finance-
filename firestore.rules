rules_version = '2';

/**
 * SIGHT FINANCE — CLOUD FIRESTORE PRODUCTION SECURITY RULES
 * 
 * Strict Principle of Least Privilege:
 * 1. Authenticated users can read and update ONLY their own user document under /users/{uid}.
 * 2. Privileged fields (balances, role, verifiedStatus, salaryLevel, directReferralsCount, createdAt)
 *    are IMMUTABLE from the client SDK.
 * 3. Never allow passwords, server-account tokens, or secret keys in documents.
 * 4. Transactions, deposit verification, and withdrawal records cannot be created or modified
 *    directly by client callers to prevent balance inflation or status tampering.
 * 5. Default-deny on all unlisted collections.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: Request is from the specific owner of the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Validates initial profile upon registration
    // Prevents initializing account with pre-set balances, admin role, or password fields
    function isValidInitialProfile(userId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.uid == userId
        && data.role == 'customer'
        && data.balances.availableUSDT == 0
        && data.balances.pendingDeposits == 0
        && data.balances.activeInvested == 0
        && data.balances.totalProfitSimulated == 0
        && data.balances.totalReferralBonus == 0
        && data.balances.totalWithdrawn == 0
        && data.directReferralsCount == 0
        && data.salaryLevel == 'None'
        && !('password' in data)
        && !('passwordHash' in data);
    }

    // Helper: Enforces that privileged fields remain unchanged during an update
    function preservesPrivilegedFields() {
      let incoming = request.resource.data;
      let existing = resource.data;
      
      return incoming.role == existing.role
        && incoming.balances == existing.balances
        && incoming.verifiedStatus == existing.verifiedStatus
        && incoming.salaryLevel == existing.salaryLevel
        && incoming.directReferralsCount == existing.directReferralsCount
        && incoming.createdAt == existing.createdAt
        && incoming.uid == existing.uid
        && incoming.id == existing.id;
    }

    // Helper: Check that no forbidden keys were included in diff
    function hasNoPrivilegedFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'role',
          'balances',
          'verifiedStatus',
          'salaryLevel',
          'directReferralsCount',
          'createdAt',
          'uid',
          'id',
          'firebaseUid',
          'accountStatus',
          'emailVerified',
          'password',
          'passwordHash'
        ]);
    }

    // -------------------------------------------------------------
    // 1. USER PROFILES: /users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read ONLY their own profile
      allow read: if isOwner(userId);

      // Initial account registration creation rule
      allow create: if isValidInitialProfile(userId);

      // Update rule: strictly restricted to permitted profile fields (fullName, country, bio, etc.)
      // Balances, roles, and administrative statuses CANNOT be changed by users
      allow update: if isOwner(userId)
                    && preservesPrivilegedFields()
                    && hasNoPrivilegedFieldChanges();

      // Deletion from web client is disabled for compliance and audit preservation
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 2. FINANCIAL TRANSACTIONS: /transactions/{txId}
    // -------------------------------------------------------------
    match /transactions/{txId} {
      // Users can only view their own transaction history
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Users CANNOT directly create, change statuses, or alter transaction amounts
      // Real transactions must be processed via secure backend / cloud functions
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 3. DEPOSIT RECORDS: /deposits/{depositId}
    // -------------------------------------------------------------
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      // Balance crediting and confirmation cannot be executed from client SDK
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 4. WITHDRAWAL RECORDS: /withdrawals/{withdrawalId}
    // -------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      // Users cannot approve, mark completed, or tamper with withdrawal statuses
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 5. DEPOSIT REQUESTS: /depositRequests/{requestId}
    // -------------------------------------------------------------
    // PHASE 1 — Client-permitted deposit notification intake.
    //
    // PURPOSE: Allows authenticated users to submit a deposit notification
    //   record for backend review. This is NOT the /deposits collection
    //   (which is server-write only). These records represent UNVERIFIED
    //   CLAIMS that must be independently validated by the backend.
    //
    // CREATE allowed only when ALL conditions are satisfied:
    //   1. uid field matches the authenticated caller's UID.
    //   2. verificationStatus is exactly 'pending_backend_review'.
    //   3. network is one of 'TRC20' or 'BEP20'.
    //   4. txHash is a string with at least 16 characters.
    //   5. tokenAmountClaimed is a positive number.
    //   6. No privileged server-only fields are present.
    //
    // READ allowed only for the owning user.
    // UPDATE, DELETE: never allowed from client SDK.
    match /depositRequests/{requestId} {
      // Users can read only their own deposit request records
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Validated create: strict field and value enforcement
      allow create: if isAuthenticated()
        // Must own the record
        && request.resource.data.uid == request.auth.uid

        // verificationStatus is locked to pending state at creation
        && request.resource.data.verificationStatus == 'pending_backend_review'

        // Network must be one of the two supported options
        && request.resource.data.network in ['TRC20', 'BEP20']

        // txHash must be a non-empty string of at least 16 characters
        && request.resource.data.txHash is string
        && request.resource.data.txHash.size() >= 16

        // tokenAmountClaimed must be a positive number
        && request.resource.data.tokenAmountClaimed is number
        && request.resource.data.tokenAmountClaimed > 0

        // Server-only fields must be null at creation (backend sets them later)
        && request.resource.data.chainTxId == null
        && request.resource.data.verifiedAmount == null

        // No privileged/dangerous keys may exist in the document
        && !request.resource.data.keys().hasAny([
          'role', 'balances', 'availableUSDT', 'pendingDeposits',
          'password', 'passwordHash', 'privateKey', 'seedPhrase',
          'adminToken', 'isAdmin', 'verified', 'creditApproved'
        ]);

      // Updates must only come from secure backend (Cloud Functions / Admin SDK)
      allow update: if false;

      // Deletion is disabled — audit trail must be preserved
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 6. DEFAULT DENY
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
